+static void vfio_fixed_bars_save(VFIOPCIDevice *vdev)
+{
+    PCIDevice *pdev = PCI_DEVICE(vdev);
+    int i;
+
+    for (i = 0; i < PCI_ROM_SLOT; i++) {
+        uint32_t bar_val = pci_get_long(pdev->config + PCI_BASE_ADDRESS_0 + i * 4);
+        bool ioport = bar_val & PCI_BASE_ADDRESS_SPACE_IO;
+        bool mem64 = !ioport && (bar_val & PCI_BASE_ADDRESS_MEM_TYPE_64);
+
+        if (ioport) {
+            vdev->host_bar_addr[i] = bar_val & PCI_BASE_ADDRESS_IO_MASK;
+        } else {
+            vdev->host_bar_addr[i] = bar_val & PCI_BASE_ADDRESS_MEM_MASK;
+            if (mem64 && i + 1 < PCI_ROM_SLOT) {
+                uint32_t bar_high = pci_get_long(pdev->config +
+                                                 PCI_BASE_ADDRESS_0 + (i + 1) * 4);
+                vdev->host_bar_addr[i] |= (uint64_t)bar_high << 32;
+                i++; /* skip upper half of 64-bit BAR */
+            }
+        }
+    }
+
+    vdev->host_bar_addr[PCI_ROM_SLOT] = pci_get_long(pdev->config + PCI_ROM_ADDRESS);
+}
+
+static bool vfio_fixed_bar_validate(VFIOPCIDevice *vdev, int nr, Error **errp)
+{
+    PCIDevice *pdev = PCI_DEVICE(vdev);
+    VFIOBAR *bar = nr == PCI_ROM_SLOT ? NULL : &vdev->bars[nr];
+    uint64_t bar_addr = vdev->host_bar_addr[nr];
+    uint64_t bar_size;
+    uint64_t bar_end;
+    MemoryRegionSection section;
+    bool overlaps_ram = false;
+
+    if (nr == PCI_ROM_SLOT) {
+        bar_size = memory_region_size(&pdev->rom);
+    } else {
+        if (!bar->size) {
+            return true;
+        }
+        bar_size = bar->size;
+    }
+
+    if (!bar_size || bar_addr == 0) {
+        return true;
+    }
+
+    bar_end = bar_addr + bar_size - 1;
+    if (bar_end < bar_addr) {
+        error_setg(errp, "VFIO fixed BAR %d address wraps around", nr);
+        return false;
+    }
+
+    /* I/O BARs live in a separate I/O port address space;
+     * skip RAM overlap check as they cannot conflict with system memory.
+     * ROM BAR addresses often overlap with reserved memory regions below
+     * 4GB (e.g. 0xfff80000). Firmware will relocate or shadow the ROM
+     * when the ROM enable bit is set, so skip the strict RAM check here. */
+    if ((nr != PCI_ROM_SLOT && bar->ioport) || nr == PCI_ROM_SLOT) {
+        return true;
+    }
+
+    /* Check RAM overlap at start */
+    section = memory_region_find(get_system_memory(), bar_addr, 1);
+    if (section.mr) {
+        if (memory_region_is_ram(section.mr)) {
+            overlaps_ram = true;
+        }
+        memory_region_unref(section.mr);
+    }
+
+    /* Check RAM overlap at end */
+    if (!overlaps_ram) {
+        section = memory_region_find(get_system_memory(), bar_end, 1);
+        if (section.mr) {
+            if (memory_region_is_ram(section.mr)) {
+                overlaps_ram = true;
+            }
+            memory_region_unref(section.mr);
+        }
+    }
+
+    if (overlaps_ram) {
+        /* 32-bit memory BARs cannot be relocated above 4GB.  When the user
+         * opts in via x-fixed-bars-allow-32bit-fallback, let the firmware
+         * dynamically reallocate this BAR instead of failing outright. */
+        if (nr != PCI_ROM_SLOT && !bar->ioport && !bar->mem64 &&
+            vdev->fixed_bars_allow_32bit_fallback) {
+            vdev->fixed_bar_fallback[nr] = true;
+            warn_report("VFIO fixed BAR %d [0x%"PRIx64"-0x%"PRIx64"] "
+                        "overlaps RAM; using dynamic allocation for 32-bit BAR",
+                        nr, bar_addr, bar_end);
+            return true;
+        }
+
+        error_setg(errp,
+                   "VFIO fixed BAR %d [0x%"PRIx64"-0x%"PRIx64"] overlaps RAM",
+                   nr, bar_addr, bar_end);
+        return false;
+    }
+
+    /* 32-bit memory BAR must be below 4GB */
+    if (nr != PCI_ROM_SLOT && !bar->ioport && !bar->mem64) {
+        if (bar_end >= 0x100000000ULL) {
+            error_setg(errp,
+                       "VFIO fixed 32-bit BAR %d [0x%"PRIx64"-0x%"PRIx64"] "
+                       "exceeds 4GB limit", nr, bar_addr, bar_end);
+            return false;
+        }
+    }
+
+    return true;
+}
+
+static void vfio_fixed_bars_preset(VFIOPCIDevice *vdev)
+{
+    PCIDevice *pdev = PCI_DEVICE(vdev);
+    int i;
+
+    for (i = 0; i < PCI_ROM_SLOT; i++) {
+        VFIOBAR *bar = &vdev->bars[i];
+        uint32_t bar_offset = PCI_BASE_ADDRESS_0 + i * 4;
+        uint64_t addr = vdev->host_bar_addr[i];
+
+        if (!bar->size || addr == 0) {
+            continue;
+        }
+
+        if (vdev->fixed_bar_fallback[i]) {
+            /* Leave this BAR zero so firmware reallocates it dynamically. */
+            continue;
+        }
+
+        if (bar->mem64) {
+            pci_default_write_config(pdev, bar_offset,
+                                     addr & 0xFFFFFFFF, 4);
+            pci_default_write_config(pdev, bar_offset + 4,
+                                     addr >> 32, 4);
+        } else {
+            pci_default_write_config(pdev, bar_offset,
+                                     (uint32_t)addr, 4);
+        }
+    }
+
+    /* ROM BAR */
+    if (vdev->host_bar_addr[PCI_ROM_SLOT] != 0 &&
+        memory_region_size(&pdev->rom) > 0) {
+        pci_default_write_config(pdev, PCI_ROM_ADDRESS,
+                                 vdev->host_bar_addr[PCI_ROM_SLOT], 4);
+    }
+}
