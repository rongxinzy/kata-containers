From c3467c93ff3834acf56dd931319bb9e07b333bb1 Mon Sep 17 00:00:00 2001
From: Developer <developer@example.com>
Date: Sun, 7 Jun 2026 12:52:18 +0000
Subject: [PATCH] MdeModulePkg/PciBusDxe: Preserve preset BAR address for VFIO
 passthrough

When QEMU presets host BAR addresses in PCI config space for VFIO
passthrough devices with x-fixed-bars=on, preserve these addresses
instead of overwriting them with newly allocated addresses.

PciParseBar() already reads and saves the original BAR value into
PciBar[].BaseAddress. In ProgramBar(), if BaseAddress is non-zero,
use it directly rather than Base + Node->Offset.
---
 MdeModulePkg/Bus/Pci/PciBusDxe/PciResourceSupport.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/MdeModulePkg/Bus/Pci/PciBusDxe/PciResourceSupport.c b/MdeModulePkg/Bus/Pci/PciBusDxe/PciResourceSupport.c
index 8ffd05f327..34845ea08f 100644
--- a/MdeModulePkg/Bus/Pci/PciBusDxe/PciResourceSupport.c
+++ b/MdeModulePkg/Bus/Pci/PciBusDxe/PciResourceSupport.c
@@ -1276,6 +1276,14 @@ ProgramBar (
 
   Address = Base + Node->Offset;
 
+  //
+  // Preserve preset BAR address for VFIO passthrough devices.
+  // QEMU presets the host BAR address in config space for such devices.
+  //
+  if (Node->PciDev->PciBar[Node->Bar].BaseAddress != 0) {
+    Address = Node->PciDev->PciBar[Node->Bar].BaseAddress;
+  }
+
   //
   // Indicate pci bus driver has allocated
   // resource for this device
-- 
